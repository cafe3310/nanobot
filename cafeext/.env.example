# nanobot Cafe Sidecar - 环境变量示例
#
# 使用说明:
# 1. 复制此文件并重命名为 .env (此文件已在 .gitignore 中屏蔽)
# 2. 填入您的私有 API Key
# 3. 运行 'nb' 命令时，这些变量会自动加载到 Bot 的运行环境

# --- 自定义模型 (Custom Provider) ---
# 在 config.json 中，如果配置如下:
# "providers": {
#   "custom": {
#     "apiBase": "http://your-endpoint/v1"
#   }
# }
# 则 LiteLLM 会自动读取名为 CUSTOM_API_KEY 的变量
CUSTOM_API_KEY=your-api-key-here

# --- 标准模型 (Standard Providers) ---
# 如果使用 OpenAI, Claude 等，请按需配置:
OPENAI_API_KEY=sk-xxxx
ANTHROPIC_API_KEY=sk-ant-xxxx
GEMINI_API_KEY=xxxx

# --- 其它敏感配置 ---
# 运行 'nb gateway' 接入社交平台时使用
DISCORD_TOKEN=your-discord-bot-token-here
